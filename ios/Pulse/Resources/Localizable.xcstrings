    "info.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no cloud, no analytics. All processing is on-device and data stays on your iPhone unless you export it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessun cloud, nessuna analisi di terze parti. Tutta l’elaborazione avviene sul dispositivo e i dati restano sul tuo iPhone finché non li esporti."
          }
        }
      }
    },
