      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observe your breathing and heart rhythm with the iPhone motion sensors."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osserva il tuo ritmo respiratorio e cardiaco con i sensori di movimento dell’iPhone."
