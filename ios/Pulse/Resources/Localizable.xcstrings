    "info.data.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every measurement is stored on your device. You can export your measurements as a CSV file to review or analyse them elsewhere."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni misurazione è salvata sul tuo dispositivo. Puoi esportare le misurazioni in un file CSV per rivederle o analizzarle altrove."
          }
        }
      }
    },
    "info.disclaimer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Important"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importante"
          }
        }
      }
    },
    "info.important.practical": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates depend heavily on staying still and on where the phone sits; the heart estimate is experimental and may be unavailable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stime dipendono molto dall’immobilità e da dove appoggi il telefono; la stima cardiaca è sperimentale e può non essere disponibile."
          }
        }
      }
    },
    "info.meaning.heart.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many times your heart beats per minute, inferred from tiny body vibrations. This signal is weak and easily disturbed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quante volte il cuore batte al minuto, dedotto da piccole vibrazioni del corpo. Questo segnale è debole e facilmente disturbato."
          }
        }
      }
    },
    "info.meaning.heart.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart rate"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequenza cardiaca"
          }
        }
      }
    },
    "info.meaning.respiration.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many full breaths you take per minute. At rest, adults are typically around 12–20."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti respiri completi fai al minuto. A riposo, negli adulti è tipicamente 12–20."
          }
        }
      }
    },
