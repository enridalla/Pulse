    "disclaimer.full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is not a medical device. The respiratory and heart rate values are experimental estimates derived from tiny chest accelerations. They are meant for awareness and observation, and must not be used for diagnosis or clinical decisions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app non è un dispositivo medico. I valori di frequenza respiratoria e cardiaca sono stime sperimentali ottenute dalle micro-accelerazioni del torace. Servono alla consapevolezza e all’osservazione e non vanno usati per diagnosi o decisioni cliniche."
          }
        }
      }
    },
    "disclaimer.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measurements are experimental estimates from the iPhone motion sensors. They do not replace medical devices, diagnoses or professional assessments."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le misurazioni sono stime sperimentali ottenute dai sensori di movimento dell’iPhone. Non sostituiscono dispositivi medici, diagnosi o valutazioni professionali."
          }
        }
      }
    },
